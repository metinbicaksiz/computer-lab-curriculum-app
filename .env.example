# Copy to .env and edit. Both server and web read this file.
DATABASE_URL=postgres://codelab:codelab@localhost:5432/codelab
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# API listens only on this machine; students reach it through the Next.js proxy.
API_HOST=127.0.0.1
API_PORT=4000
# First teacher account created by `npm run db:seed` (change the password after first login).
# Students log in with an email on this domain (staff may also use a plain username).
SCHOOL_EMAIL_DOMAIN=gobindsarvar.ca
# The one superadmin account, created by `npm run db:seed` if none exists.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=changeme
# Set to false to skip the demo class, teacher and student.
SEED_DEMO=true
