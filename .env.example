# Copy to .env and edit. Both server and web read this file.
DATABASE_URL=postgres://codelab:codelab@localhost:5432/codelab
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# API listens only on this machine; students reach it through the Next.js proxy.
API_HOST=127.0.0.1
API_PORT=4000
# First teacher account created by `npm run db:seed` (change the password after first login).
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=changeme
